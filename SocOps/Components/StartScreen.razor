<div class="poster-screen">
    <div class="poster-orb poster-orb-1" aria-hidden="true"></div>
    <div class="poster-orb poster-orb-2" aria-hidden="true"></div>
    <div class="poster-slash" aria-hidden="true"></div>

    <div class="poster-content">
        <div class="poster-badge poster-anim-1">
            <span class="poster-badge-dot" aria-hidden="true"></span>
            Social Icebreaker Event
        </div>

        <div class="poster-hero poster-anim-2">
            <h1 class="poster-title" aria-label="Soc Ops">
                SOC<span class="poster-title-accent">OPS</span>
            </h1>
            <p class="poster-tagline">Find your people.<br />Get five in a row.</p>
        </div>

        <ol class="poster-steps poster-anim-3">
            <li class="poster-step">
                <span class="poster-step-num" aria-hidden="true">01</span>
                <span class="poster-step-text">Find people who match a square</span>
            </li>
            <li class="poster-step">
                <span class="poster-step-num" aria-hidden="true">02</span>
                <span class="poster-step-text">Tap to mark your matches</span>
            </li>
            <li class="poster-step">
                <span class="poster-step-num" aria-hidden="true">03</span>
                <span class="poster-step-text">Five in a row wins!</span>
            </li>
        </ol>

        <div class="poster-anim-4">
            <button @onclick="OnStart" class="poster-cta-btn">
                Start Game
                <span class="poster-cta-arrow" aria-hidden="true">→</span>
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnStart { get; set; }
}
