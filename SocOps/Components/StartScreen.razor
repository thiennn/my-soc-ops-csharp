<div class="ss-container">
    <div class="ss-bg-orb ss-bg-orb-1" aria-hidden="true"></div>
    <div class="ss-bg-orb ss-bg-orb-2" aria-hidden="true"></div>
    <div class="ss-bg-dots" aria-hidden="true"></div>

    <div class="ss-content">
        <header class="ss-hero">
            <span class="ss-badge">Social Bingo</span>
            <h1 class="ss-title">Soc<span class="ss-title-em">Ops</span></h1>
            <p class="ss-subtitle">Find your people.&nbsp; Fill the board.&nbsp; Win the room.</p>
        </header>

        <section class="ss-steps" aria-label="How it works">
            <p class="ss-steps-eyebrow">How it works</p>
            <ol class="ss-steps-list">
                <li class="ss-step ss-step-1">
                    <span class="ss-step-num" aria-hidden="true">1</span>
                    <div>
                        <strong class="ss-step-title">Find a match</strong>
                        <span class="ss-step-desc">Mingle and find someone who matches a square on your board.</span>
                    </div>
                </li>
                <li class="ss-step ss-step-2">
                    <span class="ss-step-num" aria-hidden="true">2</span>
                    <div>
                        <strong class="ss-step-title">Tap to mark</strong>
                        <span class="ss-step-desc">Tap the square to mark it once you've found your person.</span>
                    </div>
                </li>
                <li class="ss-step ss-step-3">
                    <span class="ss-step-num" aria-hidden="true">3</span>
                    <div>
                        <strong class="ss-step-title">Five in a row wins!</strong>
                        <span class="ss-step-desc">Connect five squares — row, column, or diagonal — and shout BINGO!</span>
                    </div>
                </li>
            </ol>
        </section>

        <div class="ss-cta-wrap">
            <button class="ss-cta-btn" @onclick="OnStart">
                Start Game
                <span class="ss-cta-arrow" aria-hidden="true">→</span>
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnStart { get; set; }
}
