<div class="start-screen">
    <div class="start-content">

        <div class="start-intro">
            <span class="start-badge"><span aria-hidden="true">✦</span> Social Bingo</span>
            <h1 class="start-headline">
                Meet everyone<br />
                <span class="start-headline-accent">in the room.</span>
            </h1>
            <p class="start-tagline">
                Soc Ops turns awkward introductions into a game.
                Find people who match a square, mark your card,
                and race to get five in a row.
            </p>

            <div class="start-steps">
                <div class="start-step">
                    <span class="start-step-num">1</span>
                    <span class="start-step-text">Get a unique 5×5 card full of social questions</span>
                </div>
                <div class="start-step">
                    <span class="start-step-num">2</span>
                    <span class="start-step-text">Find someone who matches — tap the square to mark it</span>
                </div>
                <div class="start-step">
                    <span class="start-step-num">3</span>
                    <span class="start-step-text">Five in a row wins — shout Bingo!</span>
                </div>
            </div>

            <button @onclick="OnStart" class="start-cta" aria-label="Start Playing">
                Start Playing <span aria-hidden="true">→</span>
            </button>
        </div>

        <div class="start-preview" aria-hidden="true">
            <p class="start-preview-label">Sample card</p>
            <div class="start-preview-board">
                <div class="start-preview-cell">bikes to work</div>
                <div class="start-preview-cell preview-marked">has a pet</div>
                <div class="start-preview-cell">plays guitar</div>
                <div class="start-preview-cell preview-marked">loves coffee</div>
                <div class="start-preview-cell">speaks 2+ languages</div>
                <div class="start-preview-cell">born abroad</div>
                <div class="start-preview-cell preview-marked">ran a marathon</div>
                <div class="start-preview-cell">been to Asia</div>
                <div class="start-preview-cell">can juggle</div>
                <div class="start-preview-cell preview-marked">loves cooking</div>
                <div class="start-preview-cell">has a twin</div>
                <div class="start-preview-cell">does yoga</div>
                <div class="start-preview-cell preview-free">FREE</div>
                <div class="start-preview-cell">plays video games</div>
                <div class="start-preview-cell">collects things</div>
                <div class="start-preview-cell preview-marked">met a celebrity</div>
                <div class="start-preview-cell">left-handed</div>
                <div class="start-preview-cell">has a garden</div>
                <div class="start-preview-cell preview-marked">loves spicy food</div>
                <div class="start-preview-cell">went skydiving</div>
                <div class="start-preview-cell">knows sign language</div>
                <div class="start-preview-cell">was on TV</div>
                <div class="start-preview-cell">hidden talent</div>
                <div class="start-preview-cell preview-marked">reads monthly</div>
                <div class="start-preview-cell">plays an instrument</div>
            </div>
        </div>

    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnStart { get; set; }
}
